{
  "algorithm": "dqn",
  "network": "cnn",
  "encoding": "one_hot",
  "channels": 32,
  "conv_depth": 32,
  "hidden_units": 128,
  "reward": "score",
  "reward_scale": 1.0,
  "gamma": 0.99,
  "learning_rate": 0.0003,
  "batch_size": 64,
  "replay_capacity": 20000,
  "learning_starts": 1000,
  "train_every": 4,
  "target_update_every": 500,
  "epsilon_start": 1.0,
  "epsilon_end": 0.05,
  "epsilon_decay_steps": 20000,
  "epsilon_schedule": "linear",
  "double_dqn": true,
  "grad_clip": 10.0,
  "total_steps": 20000,
  "checkpoint_every": 5000,
  "evaluation_episodes": 100,
  "seed": 42,
  "device": "cpu",
  "torch_threads": 1,
  "output_dir": "outputs/kayzin_ddqn_linear"
}
